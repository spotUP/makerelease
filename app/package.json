{
  "name": "makerelease",
  "version": "0.1.0",
  "description": "Release archive maker for demoscene groups: NFO, DIZ, LHA or ZIP, Aminet upload",
  "private": true,
  "homepage": "https://github.com/spotUP/makerelease",
  "author": {
    "name": "Up Rough",
    "email": "spotup@gmail.com"
  },
  "main": "dist/main/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "tsc -p tsconfig.renderer.json && mkdir -p dist/renderer/renderer/fonts && cp src/renderer/index.html src/renderer/style.css dist/renderer/renderer/ && cp src/renderer/fonts/*.ttf dist/renderer/renderer/fonts/",
    "build": "rm -rf dist && npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "net.uprough.makerelease",
    "productName": "makerelease",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Up Rough <spotup@gmail.com>"
    }
  }
}
